POSTGRES_USER=gvrdc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gvrdc

NODE_ENV=development

# github-pages produit un site public statique ; server conserve les routes dynamiques.
DEPLOY_MODE=server
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_ENABLE_DONATION=false

# Administration serveur : credentials en production ; disabled uniquement en local.
ADMIN_AUTH_MODE=credentials
NEXTAUTH_SECRET=generate_a_long_random_value
NEXTAUTH_URL=http://localhost

# Mlinzi SMS: le token reste uniquement côté serveur.
MLINZI_SMS_URL=https://api.mlinzi.tech/messages/send
MLINZI_SMS_TOKEN=
MLINZI_SMS_SENDER_NAME=GV-RDC
